{
  "name": "@grame/faust-ui",
  "version": "1.2.0",
  "description": "Faust UI elements compositor",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "webpack --mode development",
    "postbuild": "dts-bundle-generator src/index.ts -o ./dist/index.d.ts --external-imports @grame/faustwasm --external-inlines @shren/typed-event-emitter",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grame-cncm/faust-ui.git"
  },
  "bugs": {
    "url": "https://github.com/grame-cncm/faust-ui/issues"
  },
  "homepage": "https://github.com/grame-cncm/faust-ui#readme",
  "keywords": [
    "Faust"
  ],
  "author": "Fr0stbyteR",
  "license": "GPL-3.0-or-later",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@grame/faustwasm": ">=0.4.0"
  },
  "peerDependenciesMeta": {
    "@grame/faustwasm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@grame/faustwasm": "^0.19.2",
    "@shren/typed-event-emitter": "^1.1.1",
    "@types/emscripten": "^1.39.13",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "css-loader": "^7.1.2",
    "dts-bundle-generator": "^9.5.1",
    "esbuild-loader": "^4.2.0",
    "jsdom": "^28.1.0",
    "mini-css-extract-plugin": "^2.9.0",
    "playwright": "^1.64.1",
    "raw-loader": "^4.0.2",
    "sass": "^1.77.6",
    "sass-loader": "^14.2.1",
    "style-loader": "^4.0.0",
    "typescript": "^5.4.5",
    "vitest": "^5.0.5",
    "webpack": "^5.92.0",
    "webpack-cli": "^5.1.4"
  }
}
